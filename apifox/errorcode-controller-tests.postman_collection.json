{
  "info": {
    "_postman_id": "b4f04cb6-8e2e-4d59-bf67-9d9db3c8e001",
    "name": "错误码管理 Controller 测试",
    "description": "可导入 Apifox 的 Postman Collection。请先设置 token；按文件中的顺序运行，测试数据会自动创建并在最后软删除。\n\n覆盖接口：ErrorSystemController、ErrorCategoryController、ErrorSeverityController、ErrorCodeController。\n\n权限要求：管理员 token，或具备对应 errorcode:* 权限。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const contentType = (pm.response.headers.get('Content-Type') || '').toLowerCase();",
          "pm.test('HTTP 状态码为 200', function () {",
          "    pm.expect(pm.response.code).to.eql(200);",
          "});",
          "if (contentType.includes('json')) {",
          "    const body = pm.response.json();",
          "    pm.test('业务 code 为 200', function () {",
          "        pm.expect(body.code).to.eql(200);",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "pageNum",
      "value": "1"
    },
    {
      "key": "pageSize",
      "value": "10"
    },
    {
      "key": "systemId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "severityId",
      "value": ""
    },
    {
      "key": "errorCodeId",
      "value": ""
    },
    {
      "key": "testSystemCode",
      "value": ""
    },
    {
      "key": "testCategoryCode",
      "value": ""
    },
    {
      "key": "testSeverityCode",
      "value": "99"
    },
    {
      "key": "testErrorCode",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 系统 ErrorSystemController",
      "description": "权限前缀：errorcode:system。执行到列表（测试数据）后会自动保存 systemId。",
      "item": [
        {
          "name": "查询系统列表",
          "request": {
            "method": "GET",
            "header": [],
            "description": "权限：errorcode:system:list。支持 systemCode、systemName、description、status、时间范围和分页参数。",
            "url": "{{baseUrl}}/errorcode/system/list?pageNum={{pageNum}}&pageSize={{pageSize}}&orderByColumn=id&isAsc=asc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('rows 为数组', function () { pm.expect(body.rows).to.be.an('array'); });",
                  "pm.test('total 为数字', function () { pm.expect(body.total).to.be.a('number'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "导出系统列表",
          "request": {
            "method": "POST",
            "header": [],
            "description": "权限：errorcode:system:export。响应为 Excel 文件。",
            "url": "{{baseUrl}}/errorcode/system/export"
          }
        },
        {
          "name": "新增测试系统",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('testSystemCode', 'APIFOX_SYS_' + Date.now());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "description": "权限：errorcode:system:add。systemCode 每次运行自动生成，避免重复。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"systemCode\": \"{{testSystemCode}}\",\n  \"systemName\": \"Apifox 测试系统\",\n  \"description\": \"由 Apifox 自动化测试创建\",\n  \"status\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/errorcode/system"
          }
        },
        {
          "name": "查询刚创建的系统",
          "request": {
            "method": "GET",
            "header": [],
            "description": "按本次运行生成的 systemCode 查询，并保存 systemId 供后续类别、错误码测试使用。",
            "url": "{{baseUrl}}/errorcode/system/list?systemCode={{testSystemCode}}&pageNum=1&pageSize=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const code = pm.collectionVariables.get('testSystemCode');",
                  "const target = (body.rows || []).find(function (row) { return String(row.systemCode) === String(code); });",
                  "pm.test('可以查询到刚创建的系统', function () { pm.expect(target).to.exist; });",
                  "if (target) pm.collectionVariables.set('systemId', String(target.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "查询系统详情",
          "request": {
            "method": "GET",
            "header": [],
            "description": "权限：errorcode:system:query。",
            "url": "{{baseUrl}}/errorcode/system/{{systemId}}"
          }
        },
        {
          "name": "修改测试系统",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "description": "权限：errorcode:system:edit。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{systemId}},\n  \"systemCode\": \"{{testSystemCode}}\",\n  \"systemName\": \"Apifox 测试系统-已修改\",\n  \"description\": \"修改后的系统描述\",\n  \"status\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/errorcode/system"
          }
        }
      ]
    },

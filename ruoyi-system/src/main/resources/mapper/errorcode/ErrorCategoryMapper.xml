<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.errorcode.mapper.ErrorCategoryMapper">
    
    <resultMap type="ErrorCategory" id="ErrorCategoryResult">
        <result property="id"    column="id"    />
        <result property="systemId"    column="system_id"    />
        <result property="systemName"    column="system_name"    />
        <result property="categoryCode"    column="category_code"    />
        <result property="categoryName"    column="category_name"    />
        <result property="description"    column="description"    />
        <result property="status"    column="status"    />
        <result property="version"    column="version"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectErrorCategoryVo">
        select ec.id, ec.system_id, es.system_name,
               ec.category_code, ec.category_name, ec.description, ec.status, ec.version, ec.del_flag,
               ec.create_by, ec.create_time, ec.update_by, ec.update_time
        from error_category ec
        left join error_system es on es.id = ec.system_id and es.del_flag = 0
    </sql>

    <select id="selectErrorCategoryList" parameterType="ErrorCategory" resultMap="ErrorCategoryResult">
        <include refid="selectErrorCategoryVo"/>
        <where>  
            ec.del_flag = 0
            <if test="systemId != null "> and ec.system_id = #{systemId}</if>
            <if test="systemName != null and systemName != ''"> and es.system_name like concat('%', #{systemName}, '%')</if>
            <if test="categoryCode != null  and categoryCode != ''"> and ec.category_code = #{categoryCode}</if>
            <if test="categoryName != null  and categoryName != ''"> and ec.category_name like concat('%', #{categoryName}, '%')</if>
            <if test="description != null  and description != ''"> and ec.description like concat('%', #{description}, '%')</if>
            <if test="status != null "> and ec.status = #{status}</if>
            <if test="params.beginCreateTime != null and params.beginCreateTime != '' and params.endCreateTime != null and params.endCreateTime != ''"> and ec.create_time between #{params.beginCreateTime} and #{params.endCreateTime}</if>
            <if test="params.beginUpdateTime != null and params.beginUpdateTime != '' and params.endUpdateTime != null and params.endUpdateTime != ''"> and ec.update_time between #{params.beginUpdateTime} and #{params.endUpdateTime}</if>
        </where>
    </select>
    
    <select id="selectErrorCategoryById" parameterType="Long" resultMap="ErrorCategoryResult">
        <include refid="selectErrorCategoryVo"/>
        where ec.id = #{id} and ec.del_flag = 0
    </select>

    <insert id="insertErrorCategory" parameterType="ErrorCategory" useGeneratedKeys="true" keyProperty="id">
        insert into error_category
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="systemId != null">system_id,</if>
            <if test="categoryCode != null and categoryCode != ''">category_code,</if>
            <if test="categoryName != null and categoryName != ''">category_name,</if>
            <if test="description != null">description,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="systemId != null">#{systemId},</if>
            <if test="categoryCode != null and categoryCode != ''">#{categoryCode},</if>
            <if test="categoryName != null and categoryName != ''">#{categoryName},</if>
            <if test="description != null">#{description},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
         </trim>
    </insert>

    <update id="updateErrorCategory" parameterType="ErrorCategory">
        update error_category
        <trim prefix="SET" suffixOverrides=",">
            <if test="categoryCode != null and categoryCode != ''">category_code = #{categoryCode},</if>
            <if test="categoryName != null and categoryName != ''">category_name = #{categoryName},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            version = version + 1
        </trim>
        where id = #{id} and del_flag = 0 and version = #{version}
    </update>

    <update id="deleteErrorCategoryById" parameterType="Long">
        update error_category
        set del_flag = id
        where id = #{id} and del_flag = 0
    </update>

    <update id="deleteErrorCategoryByIds" parameterType="String">
        update error_category
        set del_flag = id
        where del_flag = 0
        and id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <select id="countErrorCategoriesBySystemIds" resultType="int">
        select count(*)
        from error_category
        where del_flag = 0
          and system_id in
        <foreach item="systemId" collection="array" open="(" separator="," close=")">
            #{systemId}
        </foreach>
    </select>

    <select id="countEnabledErrorCategoriesBySystemIds" resultType="int">
        select count(*)
        from error_category
        where status = 1
          and del_flag = 0
          and system_id in
        <foreach item="systemId" collection="array" open="(" separator="," close=")">
            #{systemId}
        </foreach>
    </select>

    <select id="selectErrorCategoriesByIdsForUpdate" resultMap="ErrorCategoryResult">
        select id, system_id, null as system_name, category_code, category_name,
               description, status, version, del_flag, create_by, create_time, update_by, update_time
        from error_category
        where del_flag = 0
          and id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
        order by id
        for update
    </select>
</mapper>

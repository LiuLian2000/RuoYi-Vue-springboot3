<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.password_manage.mapper.PasswordManageTeamApplyMapper">

    <resultMap type="PasswordManageTeamApply" id="PasswordManageTeamApplyResult">
        <result property="id" column="id" />
        <result property="teamId" column="team_id" />
        <result property="teamName" column="team_name" />
        <result property="applicantPmUserId" column="applicant_pm_user_id" />
        <result property="applicantUserName" column="applicant_user_name" />
        <result property="applyReason" column="apply_reason" />
        <result property="status" column="status" />
        <result property="rejectReason" column="reject_reason" />
        <result property="reviewerPmUserId" column="reviewer_pm_user_id" />
        <result property="reviewerUserName" column="reviewer_user_name" />
        <result property="isDeleted" column="is_deleted" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <resultMap type="TeamApplyVo" id="TeamApplyVoResult">
        <result property="id" column="id" />
        <result property="teamId" column="team_id" />
        <result property="teamName" column="team_name" />
        <result property="applicantPmUserId" column="applicant_pm_user_id" />
        <result property="applicantUserName" column="applicant_user_name" />
        <result property="applyReason" column="apply_reason" />
        <result property="status" column="status" />
        <result property="rejectReason" column="reject_reason" />
        <result property="reviewerPmUserId" column="reviewer_pm_user_id" />
        <result property="reviewerUserName" column="reviewer_user_name" />
        <result property="createTime" column="create_time" />
    </resultMap>

    <sql id="selectPasswordManageTeamApplyVo">
        select id, team_id, team_name, applicant_pm_user_id, applicant_user_name, apply_reason,
               status, reject_reason, reviewer_pm_user_id, reviewer_user_name, is_deleted,
               create_time, update_time
        from password_manage_team_apply
    </sql>

    <insert id="insertPasswordManageTeamApply" parameterType="PasswordManageTeamApply" useGeneratedKeys="true" keyProperty="id">
        insert into password_manage_team_apply
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="teamId != null">team_id,</if>
            <if test="teamName != null and teamName != ''">team_name,</if>
            <if test="applicantPmUserId != null">applicant_pm_user_id,</if>
            <if test="applicantUserName != null and applicantUserName != ''">applicant_user_name,</if>
            <if test="applyReason != null">apply_reason,</if>
            <if test="status != null">status,</if>
            <if test="rejectReason != null and rejectReason != ''">reject_reason,</if>
            <if test="reviewerPmUserId != null">reviewer_pm_user_id,</if>
            <if test="reviewerUserName != null and reviewerUserName != ''">reviewer_user_name,</if>
            <if test="isDeleted != null">is_deleted,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="teamId != null">#{teamId},</if>
            <if test="teamName != null and teamName != ''">#{teamName},</if>
            <if test="applicantPmUserId != null">#{applicantPmUserId},</if>
            <if test="applicantUserName != null and applicantUserName != ''">#{applicantUserName},</if>
            <if test="applyReason != null">#{applyReason},</if>
            <if test="status != null">#{status},</if>
            <if test="rejectReason != null and rejectReason != ''">#{rejectReason},</if>
            <if test="reviewerPmUserId != null">#{reviewerPmUserId},</if>
            <if test="reviewerUserName != null and reviewerUserName != ''">#{reviewerUserName},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
        </trim>
    </insert>

    <select id="selectPasswordManageTeamApplyById" parameterType="Long" resultMap="PasswordManageTeamApplyResult">
        <include refid="selectPasswordManageTeamApplyVo"/>
        where id = #{id} and is_deleted = 0
    </select>

    <select id="selectMyApplyList" parameterType="Long" resultMap="TeamApplyVoResult">
        select id, team_id, team_name, applicant_pm_user_id, applicant_user_name, apply_reason,
               status, reject_reason, reviewer_pm_user_id, reviewer_user_name, create_time
        from password_manage_team_apply
        where applicant_pm_user_id = #{applicantPmUserId} and is_deleted = 0
        order by create_time desc
    </select>

    <select id="selectPendingApplyList" parameterType="Long" resultMap="TeamApplyVoResult">
        select id, team_id, team_name, applicant_pm_user_id, applicant_user_name, apply_reason,
               status, reject_reason, reviewer_pm_user_id, reviewer_user_name, create_time
        from password_manage_team_apply
        where team_id = #{teamId} and status = 0 and is_deleted = 0
        order by create_time asc
    </select>

    <update id="updatePasswordManageTeamApply" parameterType="PasswordManageTeamApply">
        update password_manage_team_apply
        <trim prefix="SET" suffixOverrides=",">
            <if test="teamId != null">team_id = #{teamId},</if>
            <if test="teamName != null and teamName != ''">team_name = #{teamName},</if>
            <if test="applicantPmUserId != null">applicant_pm_user_id = #{applicantPmUserId},</if>
            <if test="applyReason != null">apply_reason = #{applyReason},</if>
            <if test="status != null">status = #{status},</if>
            <if test="rejectReason != null and rejectReason != ''">reject_reason = #{rejectReason},</if>
            <if test="reviewerPmUserId != null">reviewer_pm_user_id = #{reviewerPmUserId},</if>
            <if test="reviewerUserName != null and reviewerUserName != ''">reviewer_user_name = #{reviewerUserName},</if>
        </trim>
        where id = #{id} and is_deleted = 0
    </update>

    <select id="countPendingApply" resultType="int">
        select count(1) from password_manage_team_apply
        where team_id = #{teamId} and applicant_pm_user_id = #{applicantPmUserId} and status = 0 and is_deleted = 0
    </select>

</mapper>
